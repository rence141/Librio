NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://librio:librio@localhost:5432/librio_dev

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# Redis (optional — in-memory fallback if not set)
# REDIS_URL=redis://localhost:6379

# ============ AI Guardrails Configuration ============
# All values have sensible defaults. Override as needed.

# --- Rate Limits ---
GLOBAL_REQ_PER_SEC=100
IP_REQ_PER_MIN=100
REG_PER_IP_HOUR=3

# --- Free Tier ---
FREE_REQ_PER_MIN=5
FREE_REQ_PER_HOUR=30
FREE_AI_REQ_PER_DAY=30
FREE_TOKENS_PER_DAY=30000
FREE_MAX_INPUT_TOKENS=8000
FREE_MAX_OUTPUT_TOKENS=2048
FREE_MAX_CONCURRENCY=1
FREE_CREDITS_PER_DAY=100

# --- Premium Tier ---
PREMIUM_REQ_PER_MIN=20
PREMIUM_REQ_PER_HOUR=200
PREMIUM_AI_REQ_PER_DAY=300
PREMIUM_TOKENS_PER_DAY=300000
PREMIUM_MAX_INPUT_TOKENS=16000
PREMIUM_MAX_OUTPUT_TOKENS=8192
PREMIUM_MAX_CONCURRENCY=3
PREMIUM_CREDITS_PER_DAY=1000

# --- Document Limits ---
FREE_DOC_MAX_SIZE_MB=20
FREE_DOC_MAX_PAGES=100
FREE_DOC_MAX_PER_DAY=10
FREE_DOC_MAX_STORAGE_MB=100
FREE_RAG_QUERIES_PER_DAY=50
FREE_DOC_MAX_TEXT_CHARS=500000

PREMIUM_DOC_MAX_SIZE_MB=50
PREMIUM_DOC_MAX_PAGES=500
PREMIUM_DOC_MAX_PER_DAY=100
PREMIUM_DOC_MAX_STORAGE_MB=1000
PREMIUM_RAG_QUERIES_PER_DAY=500
PREMIUM_DOC_MAX_TEXT_CHARS=2000000

# --- Global Spending Protection (Kill Switch) ---
GLOBAL_DAILY_BUDGET_USD=50
GLOBAL_MONTHLY_BUDGET_USD=1000
GLOBAL_EMERGENCY_BUDGET_USD=200

# --- Account Farming Protection ---
MAX_REG_PER_IP_HOUR=3
MAX_REG_PER_DOMAIN_DAY=20
NEW_ACCOUNT_COOLDOWN_HOURS=24
NEW_ACCOUNT_QUOTA_MULTIPLIER=0.5

# --- Concurrency / Idempotency ---
CONCURRENCY_LEASE_TTL=120
IDEMPOTENCY_TTL=3600

# ============ Cloud Provider API Keys ============
# These keys exist ONLY on the backend. NEVER in Flutter/APK/web bundle.
# NEVER commit these to git.

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash

# Custom/self-hosted
# CUSTOM_AI_BASE_URL=http://localhost:11434
# CUSTOM_AI_API_KEY=
